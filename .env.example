DJANGO_SECRET=supersecretdjangokey
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=ai-def.com,www.ai-def.com,arms.ai-def.com,127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://ai-def.com,https://www.ai-def.com,http://ai-def.com,http://www.ai-def.com,http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=https://ai-def.com,https://www.ai-def.com,http://ai-def.com,http://www.ai-def.com

POSTGRES_DB_NAME=aidef
POSTGRES_USER=aidef
POSTGRES_PASSWORD=aidef
POSTGRES_HOST=localhost
DOCKER_POSTGRES_HOST=db
POSTGRES_PORT=5432

# settings.py reads DJANGO_TIME_ZONE (default: Europe/Kyiv).
# LANGUAGE_CODE is not configurable via env — it is fixed to 'en' as the
# translation fallback; the active locale comes from the request.
DJANGO_TIME_ZONE=Region/City

MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youremail@mail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx 
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=youremail@mail.com
CONTACT_REQUEST_NOTIFICATION_EMAILS=emailto-1@mail.com,emailto-2@mail.com
STRATEGIC_PARTNERSHIP_EMAIL=strategic_partnership_email@mail.com

# --- Production only (docker-compose.prod.yml) -------------------------------
# Domains Traefik should request Let's Encrypt certificates for. Both must
# already resolve to this server's public IP before the first start, or the
# ACME HTTP-01 challenge fails.
DOMAIN=ai-def.com
DOMAIN_WWW=www.ai-def.com

# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=admin@ai-def.com

# Where persistent data lives (postgres, uploaded media, certs, traefik logs).
# Point this at a dedicated, snapshotted disk in production, e.g. /data/web.
DATA_DIR=./data

# Optional: pull prebuilt images from GHCR instead of building on the server.
# Leave unset to build locally. Pin to a :sha-<commit> tag to allow rollback.
# BACKEND_IMAGE=ghcr.io/<owner>/aidef-backend:latest
# FRONTEND_IMAGE=ghcr.io/<owner>/aidef-frontend:latest
